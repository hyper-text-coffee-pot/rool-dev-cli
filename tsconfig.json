{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "rootDir": "./src/app",
        "outDir": "./dist",
        "types": ["node"],
        "paths": {
            "@app/*": ["./src/app/*"]
        }
    },
    "include": ["src/**/*"]
}